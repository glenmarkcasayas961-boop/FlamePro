<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/setupProfileScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="@color/white"
    tools:context="com.example.flamepro.SetupProfileActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Profile Image Avatar Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/avatarContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfileAvatar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_flamepro_logo"
                android:scaleType="fitCenter"
                android:padding="2dp"
                app:strokeColor="@color/divider_gray"
                app:strokeWidth="1dp"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivCameraBadge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_camera"
                android:background="@color/brand_subtitle_red"
                android:tint="@color/white"
                android:padding="6dp"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                app:layout_constraintBottom_toBottomOf="@id/ivProfileAvatar"
                app:layout_constraintEnd_toEndOf="@id/ivProfileAvatar"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tvUserProfileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_profile"
            android:textColor="@color/brand_subtitle_red"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/avatarContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSetUpProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_up_your_profile"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvUserProfileLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Row 1: First Name and Last Name -->
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/flowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:constraint_referenced_ids="llFirstName,llLastName"
            app:flow_wrapMode="aligned"
            app:flow_horizontalStyle="spread"
            app:flow_horizontalGap="12dp"
            app:flow_verticalGap="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvSetUpProfileTitle" />

        <LinearLayout
            android:id="@+id/llFirstName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="MissingConstraints">
            <TextView
                android:id="@+id/lblFirstName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/first_name"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edit_text_bg"
                android:hint="@string/enter_first_name"
                android:textColorHint="@color/hint_color"
                android:textColor="@color/input_text_color"
                android:textSize="13sp"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                tools:ignore="Autofill" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llLastName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="MissingConstraints">
            <TextView
                android:id="@+id/lblLastName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lastname"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edit_text_bg"
                android:hint="@string/enter_last_name"
                android:textColorHint="@color/hint_color"
                android:textColor="@color/input_text_color"
                android:textSize="13sp"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                tools:ignore="Autofill" />
        </LinearLayout>

        <!-- Row 2: Middle Name and Phone Number -->
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/flowContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:constraint_referenced_ids="llMiddleName,llPhoneNumber"
            app:flow_wrapMode="aligned"
            app:flow_horizontalStyle="spread"
            app:flow_horizontalGap="12dp"
            app:flow_verticalGap="12dp"
            app:layout_constraintTop_toBottomOf="@id/flowName" />

        <LinearLayout
            android:id="@+id/llMiddleName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="MissingConstraints">
            <TextView
                android:id="@+id/lblMiddleName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/middle_name_optional"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etMiddleName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edit_text_bg"
                android:hint="@string/enter_middle_name"
                android:textColorHint="@color/hint_color"
                android:textColor="@color/input_text_color"
                android:textSize="13sp"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                tools:ignore="Autofill" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llPhoneNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="MissingConstraints">
            <TextView
                android:id="@+id/lblPhoneNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_number"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edit_text_bg"
                android:hint="@string/enter_phone_number"
                android:textColorHint="@color/hint_color"
                android:textColor="@color/input_text_color"
                android:textSize="13sp"
                android:inputType="phone"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                tools:ignore="Autofill" />
        </LinearLayout>

        <!-- Full Width Fields: Address -->
        <TextView
            android:id="@+id/lblAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/address"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/flowContact"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edit_text_bg"
            android:hint="@string/street"
            android:textColorHint="@color/hint_color"
            android:textColor="@color/input_text_color"
            android:textSize="13sp"
            android:inputType="textPostalAddress"
            android:paddingHorizontal="12dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/lblAddress"
            tools:ignore="Autofill" />

        <!-- Full Width Fields: Barangay -->
        <TextView
            android:id="@+id/lblBarangay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/barangay"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/etAddress"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etBarangay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edit_text_bg"
            android:hint="@string/barangay"
            android:textColorHint="@color/hint_color"
            android:textColor="@color/input_text_color"
            android:textSize="13sp"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/lblBarangay"
            tools:ignore="Autofill" />

        <!-- Full Width Fields: City -->
        <TextView
            android:id="@+id/lblCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/city"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/etBarangay"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etCity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edit_text_bg"
            android:hint="@string/city"
            android:textColorHint="@color/hint_color"
            android:textColor="@color/input_text_color"
            android:textSize="13sp"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/lblCity"
            tools:ignore="Autofill" />

        <!-- Full Width Fields: Province -->
        <TextView
            android:id="@+id/lblProvince"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/province"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/etCity"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etProvince"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edit_text_bg"
            android:hint="@string/province"
            android:textColorHint="@color/hint_color"
            android:textColor="@color/input_text_color"
            android:textSize="13sp"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/lblProvince"
            tools:ignore="Autofill" />

        <!-- Action Button Save Profile -->
        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/save_profile"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/brand_subtitle_red"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/etProvince"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
